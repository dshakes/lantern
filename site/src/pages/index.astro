---
import Page from '../layouts/Page.astro';
import Phone from '../components/Phone.astro';
import Glyph from '../components/Glyph.astro';
import Copy from '../components/Copy.astro';
import Logo from '../components/Logo.astro';
import { PROMISE } from '../data/promise';
import { u, DEMO, GH } from '../data/site';
---
<Page title="pal — your pal for every moment" description="pal is a personal agent that replies in your voice, remembers your people and asks before it promises anything. PAL Runtime is the open-source layer it runs on, for the agents you build.">
  <section class="hero" aria-labelledby="hero-h">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">pal · the <b>Personal Agentic Layer</b></p>
        <h1 id="hero-h" class="display">Your pal for every moment.</h1>
        <p class="lede">A friend that gets things done, and asks first. pal answers your messages in your voice, keeps track of your people and plans, and holds anything that matters until you say yes.</p>
        <p class="lede" style="margin-top:12px">Building agents of your own? PAL Runtime is the open-source layer pal runs on.</p>
        <div class="actions">
          <a class="btn btn-primary" href={u('pal/')}>Meet pal</a>
          <a class="btn btn-ghost" href={u('runtime/')}>PAL Runtime for builders</a>
        </div>
      </div>
      <Phone who="Maya" label="A chat where pal holds a reply that would promise money" caption="Invented example. pal held it for you.">
        <span class="stamp">Today 6:42 PM</span>
        <p class="bubble them">hey! did you see the cabin is booked for the 14th 🎉</p>
        <p class="bubble me">yes!! can't wait</p>
        <p class="bubble them">could you send your share today? $300, I fronted it</p>
        <div class="held" role="note">
          <p class="tag">pal held this for you</p>
          <p class="draft">“sending it tonight 👍”</p>
          <p class="why">It promises money, so it waits for your yes.</p>
          <p class="btns" aria-hidden="true"><span>Send</span><span>Edit</span></p>
        </div>
      </Phone>
    </div>
  </section>

  <section class="section band" aria-labelledby="promise-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">The PAL Promise</p>
        <h2 id="promise-h" class="h2" style="margin-top:12px">Four things pal will always do.</h2>
      </div>
      <ul class="grid-4">
        {PROMISE.map((p) => (
          <li class="card">
            <Glyph kind={p.kind} />
            <h3 class="h3">{p.title}</h3>
            <p>{p.body}</p>
            <a class="arrow-link more" href={u(p.href)}>How it works</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="doors-h">
    <div class="wrap">
      <div class="section-head center">
        <h2 id="doors-h" class="h2">One layer. Two ways in.</h2>
        <p class="lede">The same layer that looks after your messages runs agents for teams. Pick the door that fits.</p>
      </div>
      <div class="grid-2">
        <a class="card door" href={u('pal/')}>
          <span class="pill">For you</span>
          <h3 class="h2">pal, your personal agent</h3>
          <p class="body2" style="margin-top:12px">Lives in iMessage and WhatsApp, on your own Mac.</p>
          <ul>
            <li>Replies to people the way you would</li>
            <li>Remembers who is who, across both apps</li>
            <li>A daily Brief of the moments that need you</li>
            <li>Holds money and promises for your yes</li>
          </ul>
          <span class="arrow-link go">Meet pal</span>
        </a>
        <a class="card door" href={u('runtime/')}>
          <Logo variant="runtime" size={20} />
          <h3 class="h2">PAL Runtime, for builders</h3>
          <p class="body2" style="margin-top:12px">Run your own agents in your own cloud. Apache-2.0.</p>
          <ul>
            <li>It finishes: runs resume after a crash</li>
            <li>It’s contained: code runs in a microVM, keys stay out</li>
            <li>It’s yours: deploy in your VPC, budgets enforced up front</li>
            <li>Every run can carry a signed receipt</li>
          </ul>
          <span class="arrow-link go">Explore PAL Runtime</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section rule" aria-labelledby="moments-h">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Brief</p>
        <h2 id="moments-h" class="h2" style="margin-top:12px">Only the moments that need you.</h2>
        <p class="lede" style="margin-top:16px">Ask pal what’s up and it ranks what is waiting on you: people you haven’t answered, replies it held, things you said you would do. Answer with a number and it drafts the reply.</p>
        <a class="arrow-link" style="margin-top:16px" href={u('pal/')}>See everything pal does</a>
      </div>
      <Phone who="pal" initial="p" label="A daily Brief from pal listing three moments that need you">
        <p class="bubble me">what’s up?</p>
        <div class="pal-msg">
          <p class="from">pal</p>
          <p>3 moments need you</p>
          <ol>
            <li><span>1</span><span><b>Jordan</b> has waited 2 days for an answer about Saturday</span></li>
            <li><span>2</span><span><b>Held</b>: your reply to Maya promises $300</span></li>
            <li><span>3</span><span>You said you’d send Alex the slides</span></li>
          </ol>
        </div>
        <p class="bubble me">1</p>
        <div class="pal-msg"><p class="from">pal</p><p>Draft for Jordan: “so sorry, Saturday works! 11 at the park?” Reply send or edit.</p></div>
      </Phone>
    </div>
  </section>

  <section class="section band closer" aria-labelledby="close-h">
    <div class="wrap">
      <p class="eyebrow">Proof, not promises</p>
      <h2 id="close-h" class="h2">pal runs on PAL Runtime.</h2>
      <p class="lede" style="margin:20px auto 0">The layer that runs your life can run your agents. Everything here is open source; try the whole stack on your laptop with Docker, no API key needed.</p>
      <ul class="strip" style="margin-top:28px" aria-label="Facts about the project">
        <li>Apache-2.0</li><li>Firecracker / Kata microVMs</li><li>Go + Rust</li><li>Tests in CI</li>
      </ul>
      <Copy cmd={DEMO} label="Clone and start the demo" />
      <div class="actions">
        <a class="btn btn-primary" href={u('docs/start/quickstart/')}>Read the quickstart</a>
        <a class="btn btn-ghost" href={GH}>View on GitHub</a>
      </div>
    </div>
  </section>
</Page>
