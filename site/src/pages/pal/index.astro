---
import Page from '../../layouts/Page.astro';
import Phone from '../../components/Phone.astro';
import Glyph from '../../components/Glyph.astro';
import { PROMISE } from '../../data/promise';
import { u } from '../../data/site';
// Every capability below maps to a shipped bridge feature (CLAUDE.md, "Personal-docs + agentic Mac actions").
const CAPS = [
  { t: 'Voice', h: 'Replies the way you would.', b: 'pal learns your style from the messages you have actually sent: your length, your slang, your languages. A reply that doesn’t sound like you is rewritten before it goes out.' },
  { t: 'People', h: 'Remembers who is who.', b: 'One memory of each person across iMessage and WhatsApp, so a plan made on one app is known on the other.' },
  { t: 'Brief', h: 'Brings you the moments.', b: 'Ask “what’s up” and pal ranks what needs you: people waiting on an answer, held replies, things you said you’d do.' },
  { t: 'Holds', h: 'Asks before it promises.', b: 'Money, commitments, dates it can’t check and replies to sad news wait for your yes. pal held it for you.' },
  { t: 'Actions', h: 'Books it. Notes it.', b: 'Say yes to a follow-up and pal adds the event to Calendar, saves a note or drafts the email on your Mac.' },
  { t: 'Docs', h: 'Finds your documents.', b: 'Ask for a document and pal searches the folders you allow on your Mac, reads it and answers. Nothing outside those folders.' },
  { t: 'Watch', h: 'Keeps an eye on things.', b: 'A friend mentions a flight in the air or a game on tonight; pal checks back and sends one short update when it lands.' },
  { t: 'Learns', h: 'Gets better when you say so.', b: 'Thumbs-down a reply and pal keeps it. Patterns you reject again and again become style lessons for every chat.' },
];
---
<Page path="pal/" title="pal — a friend that gets things done, and asks first" description="pal lives in iMessage and WhatsApp on your own Mac. It replies in your voice, remembers your people, brings you a daily Brief and holds money and promises for your yes.">
  <section class="hero" aria-labelledby="hero-h">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">pal · your personal agent</p>
        <h1 id="hero-h" class="display">A friend that gets things done, and asks first.</h1>
        <p class="lede">pal lives in your iMessage and WhatsApp. It replies the way you would, remembers the people in your life, and only brings you the moments that need you.</p>
        <div class="actions">
          <a class="btn btn-primary" href={u('docs/pal/')}>Set up pal</a>
          <a class="btn btn-ghost" href="#holds">How Holds work</a>
        </div>
      </div>
      <Phone who="Sam" label="pal replying to a friend in the owner's voice" caption="Invented example. pal answered; it sounded like you.">
        <span class="stamp">Sat 10:14 AM</span>
        <p class="bubble them">are we still on for brunch tomorrow?</p>
        <p class="bubble me">yes! 11 at the usual place?</p>
        <p class="bubble them">perfect. can I bring my sister?</p>
        <p class="bubble me">of course, the more the merrier</p>
        <p class="bubble them">see you there 🙌</p>
      </Phone>
    </div>
  </section>

  <section class="section band" aria-labelledby="caps-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="caps-h" class="h2">What pal does for you.</h2>
        <p class="lede">Plain things, done well, in the apps you already use.</p>
      </div>
      <ul class="grid-4">
        {CAPS.map((c) => (
          <li class="card"><p class="eyebrow">{c.t}</p><h3 class="h3" style="margin-top:10px">{c.h}</h3><p>{c.b}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section id="holds" class="section" aria-labelledby="holds-h">
    <div class="wrap split">
      <Phone who="Maya" label="pal holds a reply that would promise money and asks you first">
        <p class="bubble them">could you send your share today? $300, I fronted it</p>
        <div class="held" role="note">
          <p class="tag">pal held this for you</p>
          <p class="draft">“sending it tonight 👍”</p>
          <p class="why">It promises money, so it waits for your yes.</p>
          <p class="btns" aria-hidden="true"><span>Send</span><span>Edit</span></p>
        </div>
      </Phone>
      <div>
        <p class="eyebrow">Holds</p>
        <h2 id="holds-h" class="h2" style="margin-top:12px">pal held it for you.</h2>
        <p class="lede" style="margin-top:16px">An agent that talks for you should never spend your money or your word on a guess. When a reply matters, pal stops and asks.</p>
        <ul class="checklist">
          <li><span><b>Money.</b> Someone asks for it or the reply would promise it, in any language.</span></li>
          <li><span><b>Promises.</b> A reply that commits you to do something.</span></li>
          <li><span><b>Facts it can’t check.</b> A date, a plan or an outcome only you would know.</span></li>
          <li><span><b>Hard news.</b> A loss or an illness gets your words, not a cheerful guess.</span></li>
        </ul>
        <p class="small" style="margin-top:20px">These checks run before every send, and a backup check keeps working even if the AI model is unavailable.</p>
      </div>
    </div>
  </section>

  <section class="section rule" aria-labelledby="control-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="control-h" class="h2">You stay in charge.</h2>
      </div>
      <div class="grid-4">
        <div class="card"><h3 class="h3">Mute</h3><p>pal keeps thinking but stops sending. Every reply becomes a draft for you to approve.</p></div>
        <div class="card"><h3 class="h3">Kill switch</h3><p>One message and pal ignores everything until you turn it back on.</p></div>
        <div class="card"><h3 class="h3">Quiet hours</h3><p>Messages that arrive overnight wait for morning, then get answered at a natural pace.</p></div>
        <div class="card"><h3 class="h3">Owner only</h3><p>Only you can ask pal about your documents or tell it to act. Contacts just get replies.</p></div>
      </div>
    </div>
  </section>

  <section class="section band" aria-labelledby="private-h">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Private by design</p>
        <h2 id="private-h" class="h2" style="margin-top:12px">Your life stays on your Mac.</h2>
        <p class="lede" style="margin-top:16px">pal runs on a Mac you own, reads only what you allow, and keeps its most personal memory encrypted on disk.</p>
      </div>
      <ul class="checklist" style="margin-top:0">
        <li><span><b>Your machine.</b> The bridges to iMessage and WhatsApp run on your Mac, not on someone else’s server.</span></li>
        <li><span><b>Your folders.</b> Document search is limited to the folders you list.</span></li>
        <li><span><b>Encrypted memory.</b> Conversation memory and topics are encrypted at rest (AES-256-GCM) and readable only by your user.</span></li>
        <li><span><b>Opt-in signals.</b> Anything that watches how you use your Mac is off unless you turn it on.</span></li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="promise-h">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">The PAL Promise</p><h2 id="promise-h" class="h2" style="margin-top:12px">What you can count on.</h2></div>
      <ul class="grid-4">
        {PROMISE.map((p) => (<li class="card"><Glyph kind={p.kind} /><h3 class="h3">{p.title}</h3><p>{p.body}</p><a class="arrow-link more" href={u(p.href)}>How it works</a></li>))}
      </ul>
    </div>
  </section>

  <section class="section band closer" aria-labelledby="start-h">
    <div class="wrap">
      <h2 id="start-h" class="h2">Bring pal home.</h2>
      <p class="lede" style="margin:20px auto 0">pal is open source and runs on your own Mac today. Setup takes some comfort with a terminal; the guide walks you through each step.</p>
      <div class="actions"><a class="btn btn-primary" href={u('docs/pal/')}>Read the setup guide</a><a class="btn btn-ghost" href={u('runtime/')}>What pal runs on</a></div>
    </div>
  </section>
</Page>
