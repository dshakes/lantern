---
// Tiny bespoke graphics for the four promises. Line art in currentColor + one ember dot.
interface Props { kind: 'voice' | 'people' | 'asks' | 'steady' }
const { kind } = Astro.props;
---
<svg class="glyph" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {kind === 'voice' && (
    <>
      <path d="M6 24v0M12 18v12M18 12v24M24 16v16M30 20v8M36 14v20M42 22v4" opacity=".35" />
      <path d="M6 24v0M12 19v10M18 13v22M24 17v14M30 21v6M36 15v18M42 23v2" />
      <circle cx="24" cy="42" r="2.5" fill="#ff5b2e" stroke="none" />
    </>
  )}
  {kind === 'people' && (
    <>
      <path d="M14 14 L34 12 M14 14 L22 34 M34 12 L22 34 M34 12 L40 30 M22 34 L40 30" opacity=".45" />
      <circle cx="14" cy="14" r="4" /><circle cx="34" cy="12" r="4" /><circle cx="40" cy="30" r="4" />
      <circle cx="22" cy="34" r="5" fill="#ff5b2e" stroke="none" />
    </>
  )}
  {kind === 'asks' && (
    <>
      <path d="M8 12a6 6 0 0 1 6-6h20a6 6 0 0 1 6 6v14a6 6 0 0 1-6 6H22l-8 8v-8a6 6 0 0 1-6-6Z" />
      <circle cx="24" cy="19" r="4.5" fill="#ff5b2e" stroke="none" />
    </>
  )}
  {kind === 'steady' && (
    <>
      <rect x="15" y="15" width="18" height="18" rx="5" />
      <path d="M40 24a16 16 0 1 1-4.7-11.3" />
      <path d="M36 6v7h-7" />
      <circle cx="24" cy="24" r="3" fill="#ff5b2e" stroke="none" />
    </>
  )}
</svg>
