---
// One diagram, four files: landscape + portrait, dark + light (public/diagrams/).
// Theme follows data-theme (CSS hides the other pair); <source media> swaps in
// the portrait drawing on narrow screens. Hidden lazy images never download.
import { u } from '../data/site';
const ALT: Record<string, string> = {
  'crash-resume': 'Steps 1 and 2 are journaled, the process crashes in step 3, the recovery sweep re-acquires the lock, steps 1 and 2 are replayed from the journal and step 3 runs again with the same idempotency key, so it is billed once.',
  'sandbox-egress': 'A tool call reaches code in a microVM with no network card. Over vsock it reaches the host broker, which applies the allowlist and adds the key; keys stay on the host. An allowed host goes through, any other host is refused and audited.',
  'your-cloud': 'The control plane, run wherever you deploy it, holds the API, console, scheduling and routing. The data plane in your VPC, with microVM sandboxes and run data, dials out to it; runs come back over that connection. No inbound ports.',
  'budget-gate': 'A run request meets the budget check (forecast and daily caps). Over the cap it is refused with 402, no model call, costing nothing. Under the cap it is routed by capability and the usage is recorded.',
};
interface Props { name: keyof typeof ALT; alt?: string; caption?: string; eager?: boolean }
const { name, caption, eager = false } = Astro.props;
const alt = Astro.props.alt ?? ALT[name];
const src = (t: string, p = '') => u(`diagrams/${name}${p}-${t}.svg`);
const loading = eager ? 'eager' : 'lazy';
---
<figure class="diagram">
  {['dark', 'light'].map((t) => (
    <picture class={`d-${t}`}>
      <source media="(max-width: 640px)" srcset={src(t, '-portrait')} />
      <img src={src(t)} alt={alt} width="960" loading={loading} decoding="async" />
    </picture>
  ))}
  {caption && <figcaption set:html={caption} />}
</figure>
<style is:global>
  /* global so it applies identically on marketing pages and inside Starlight docs */
  .diagram { margin: 1.75rem 0; max-width: 960px; }
  .diagram img { display: block; width: 100%; height: auto; margin: 0; border-radius: 18px; border: 1px solid var(--p-border); }
  .diagram figcaption { margin-top: 14px; font-size: 14px; line-height: 22px; color: var(--p-text-3); max-width: 72ch; }
  :root[data-theme='light'] .diagram .d-dark, :root:not([data-theme='light']) .diagram .d-light { display: none; }
  @media (max-width: 640px) { .diagram img { max-width: 420px; margin: 0 auto; } }
</style>
