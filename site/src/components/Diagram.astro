---
// A docs diagram: the light/dark SVG pair in public/diagrams/, generated by
// scripts/diagrams.mjs. Starlight's theme classes show the one that matches
// the page. An unknown name fails the build.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
interface Props { name: string; alt: string }
const { name, alt } = Astro.props;
for (const t of ['light', 'dark']) {
  if (!existsSync(join(process.cwd(), 'public/diagrams', `${name}-${t}.svg`))) throw new Error(`Diagram "${name}": public/diagrams/${name}-${t}.svg not found; run node scripts/diagrams.mjs`);
}
const src = (t: string) => `${import.meta.env.BASE_URL}diagrams/${name}-${t}.svg`;
---
<img class="diagram dark:sl-hidden" src={src('light')} alt={alt} width="880" loading="lazy" decoding="async" />
<img class="diagram light:sl-hidden" src={src('dark')} alt={alt} width="880" loading="lazy" decoding="async" />
