---
// Onboarding path rail: where this page sits in "Start here". Highlights the
// current step; earlier steps read as done. Purely presentational, links only.
import { u } from '../data/site';
interface Props { current: number }
const { current } = Astro.props;
const steps = [
  { t: 'See it run', s: 'No key, one command', href: '/docs/start/sixty-seconds/' },
  { t: 'Your first agent', s: 'One sentence to a run', href: '/docs/start/quickstart/' },
  { t: 'Develop locally', s: 'Edit, save, re-run', href: '/docs/start/local-dev/' },
  { t: 'Deploy', s: 'Your cloud, your keys', href: '/docs/start/deploy/' },
];
---
<nav class="prog not-content" aria-label="Start here">
  <ol>
    {steps.map((st, i) => (
      <li class={i + 1 === current ? 'on' : i + 1 < current ? 'done' : ''}>
        <a href={u(st.href)} aria-current={i + 1 === current ? 'step' : undefined}>
          <span class="n">{i + 1 < current ? '✓' : i + 1}</span>
          <span class="tx"><span class="t">{st.t}</span><span class="s">{st.s}</span></span>
        </a>
      </li>
    ))}
  </ol>
</nav>
<style>
  .prog { margin: 0 0 2rem; }
  .prog ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; position: relative; }
  .prog li { margin: 0; position: relative; }
  .prog li + li::before { content: ''; position: absolute; top: 15px; left: calc(-50% + 18px); right: calc(50% + 18px); height: 2px; background: var(--sl-color-hairline-light); }
  .prog li.done + li::before, .prog li.on::before { background: var(--p-rt-grad); }
  .prog a { display: grid; justify-items: center; gap: 8px; text-align: center; text-decoration: none; color: inherit; padding: 0 4px; }
  .prog .n { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; font: 600 13px var(--p-mono);
    border: 1.5px solid var(--sl-color-hairline-light); background: var(--sl-color-bg); color: var(--sl-color-gray-2); position: relative; z-index: 1; }
  .prog li.done .n { background: var(--p-rt-bg); border-color: var(--p-rt-line); color: var(--p-rt-text); }
  .prog li.on .n { background: var(--p-rt-btn); border-color: transparent; color: #fff; box-shadow: 0 0 0 4px var(--p-rt-bg), 0 8px 24px -8px var(--p-rt-1); }
  .prog .tx { display: grid; gap: 2px; }
  .prog .t { font-weight: 600; font-size: 0.875rem; color: var(--sl-color-white); line-height: 1.25; }
  .prog .s { font-size: 0.78rem; color: var(--sl-color-gray-3); line-height: 1.3; }
  .prog li:not(.on) .t { color: var(--sl-color-gray-2); }
  .prog a:hover .t { color: var(--sl-color-white); }
  @media (max-width: 560px) { .prog .s { display: none; } .prog .t { font-size: 0.78rem; } }
</style>
