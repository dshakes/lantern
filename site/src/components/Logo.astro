---
// The ONE place the pal logo lives in pages ("Held": a p whose bowl holds a
// dot, the moment pal keeps for you). Strokes use currentColor so the logo
// follows the theme; the dot carries the product ramp.
// variant="runtime" swaps the dot to the electric ramp and sets "Runtime" as
// real text. Static files for README / external use: public/brand/.
// ponytail: geometry mirrors WORD in docs/brand/build/brand.mjs; change both together.
interface Props { size?: number; variant?: 'pal' | 'runtime'; class?: string }
const { size = 24, variant = 'pal', class: cls } = Astro.props;
const rt = variant === 'runtime';
const label = rt ? 'PAL Runtime' : 'pal';
const gid = `pal-dot-${Math.random().toString(36).slice(2, 8)}`;
const [a, b] = rt ? ['#6c5cff', '#14c8f0'] : ['#ff7a3d', '#e5207f'];
---
<span class:list={['pal-logo', cls]} style={`--s:${size}px`} role="img" aria-label={label}>
  <svg class="word" viewBox="0 -11 114 80" aria-hidden="true">
    <defs><linearGradient id={gid} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color={a} /><stop offset="1" stop-color={b} /></linearGradient></defs>
    <g stroke="currentColor" fill="none" stroke-width="9" stroke-linecap="round"><path d="M4.5 13 V64 M81 13 V43 M100 -6 V34 A9 9 0 0 0 109 43" /><circle cx="19.5" cy="28" r="15" /><circle cx="66" cy="28" r="15" /></g>
    <circle cx="19.5" cy="28" r="6.5" fill={`url(#${gid})`} />
  </svg>
  {rt && <span class="rt" aria-hidden="true">Runtime</span>}
</span>
<style>
  .pal-logo { display: inline-flex; align-items: center; gap: calc(var(--s) * 0.3); line-height: 1; color: var(--p-text, var(--sl-color-white)); }
  .word { height: calc(var(--s) * 1.2); width: auto; aspect-ratio: 114 / 80; flex: none; overflow: visible; }
  .rt { font-family: var(--p-display, 'Inter Tight Variable', system-ui, sans-serif); font-weight: 500; font-size: calc(var(--s) * 0.95); letter-spacing: -0.025em; color: var(--p-text, var(--sl-color-white)); }
</style>
