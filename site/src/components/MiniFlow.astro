---
// A small, static (no JS) animated thumbnail of an interactive diagram, drawn
// at build time from the same FlowDef / SequenceDef the full island uses, so a
// thumbnail can never drift from the diagram it links to. The first scenario's
// path is lit in the product's accent and a pulse travels it step by step.
import type { FlowDef } from './diagrams/FlowDiagram';
import type { SequenceDef } from './diagrams/sequences';
import { route, toPath } from './diagrams/geometry';

interface Props { def?: FlowDef; seq?: SequenceDef; brand?: 'pal' | 'rt'; label?: string }
const { def, seq, label } = Astro.props;
const STEP = 0.9; // seconds per step in the travelling pulse

type Box = { id: string; x: number; y: number; w: number; h: number; tone: string; lit: boolean };
type Line = { d: string; lit: boolean; deny: boolean; delay: number; dur: number };
let vb: [number, number] = [980, 400];
let boxes: Box[] = [];
let lines: Line[] = [];
let frames: { x: number; y: number; w: number; h: number; kind: string }[] = [];
let period = 4;
let brand = Astro.props.brand ?? 'rt';

if (def) {
  vb = def.vb;
  brand = Astro.props.brand ?? def.brand ?? (def.nodes.some((n) => n.tone === 'pal') ? 'pal' : 'rt');
  const steps = def.scenarios?.[0]?.steps ?? [];
  const litN = new Map<string, number>();
  const litE = new Map<string, { i: number; deny: boolean }>();
  steps.forEach((s, i) => {
    s.nodes?.forEach((n) => litN.has(n) || litN.set(n, i));
    s.edges?.forEach((k) => {
      if (!litE.has(k)) litE.set(k, { i, deny: !!s.deny && k === s.edges?.at(-1) });
      k.split('>').forEach((n) => litN.has(n) || litN.set(n, i));
    });
  });
  period = Math.max(3, steps.length) * STEP + 1.2;
  boxes = def.nodes.map((n) => ({ id: n.id, x: n.x, y: n.y, w: n.w ?? 150, h: n.h ?? 54, tone: n.tone ?? 'plain', lit: litN.has(n.id) }));
  const by = new Map(boxes.map((b) => [b.id, b]));
  lines = def.edges.map((e) => {
    const a = by.get(e.from)!, b = by.get(e.to)!;
    const hit = litE.get(`${e.from}>${e.to}`);
    return { d: toPath(route(a, b, e.via)), lit: !!hit, deny: !!hit?.deny, delay: (hit?.i ?? 0) * STEP, dur: STEP };
  });
  frames = (def.frames ?? []).map((f) => ({ x: f.x, y: f.y, w: f.w, h: f.h, kind: f.kind ?? 'zone' }));
} else if (seq) {
  const L = seq.lifelines.length;
  const steps = seq.scenarios[0]?.steps.slice(0, 9) ?? [];
  const colW = 150, top = 20, headH = 46, rowH = 34;
  vb = [L * colW + 20, top + headH + 24 + steps.length * rowH + 10];
  const cx = new Map(seq.lifelines.map((l, i) => [l.id, 20 + i * colW + (colW - 20) / 2]));
  boxes = seq.lifelines.map((l, i) => ({ id: l.id, x: 20 + i * colW, y: top, w: colW - 20, h: headH, tone: l.tone, lit: steps.some((s) => s.from === l.id || s.to === l.id) }));
  const lifeTop = top + headH, lifeBot = vb[1] - 6;
  lines = seq.lifelines.map((l) => ({ d: `M${cx.get(l.id)} ${lifeTop} L${cx.get(l.id)} ${lifeBot}`, lit: false, deny: false, delay: 0, dur: 0 }));
  steps.forEach((s, i) => {
    const y = lifeTop + 24 + i * rowH;
    const a = cx.get(s.from)!, b = cx.get(s.to)!;
    const d = a === b ? `M${a} ${y} h28 v14 h-24` : `M${a} ${y} L${b + (b > a ? -6 : 6)} ${y}`;
    lines.push({ d, lit: true, deny: s.kind === 'deny', delay: i * STEP, dur: STEP });
  });
  period = Math.max(3, steps.length) * STEP + 1.2;
}
---
<svg class={`mf b-${brand}`} viewBox={`0 0 ${vb[0]} ${vb[1]}`} role="img" aria-label={label ?? def?.title ?? seq?.title} style={`--mf-period:${period}s`} preserveAspectRatio="xMidYMid meet">
  {frames.map((f) => <rect class={`mf-fr k-${f.kind}`} x={f.x} y={f.y} width={f.w} height={f.h} rx="16" />)}
  {lines.map((l) => (
    <g class={`mf-e${l.lit ? ' lit' : ''}${l.deny ? ' deny' : ''}`} style={`--d:${l.delay}s`}>
      <path d={l.d} />
      {l.lit && (
        <circle class="mf-dot" r="7">
          <animateMotion dur={`${period}s`} repeatCount="indefinite" path={l.d}
            keyTimes={`0;${(l.delay / period).toFixed(3)};${Math.min(1, (l.delay + l.dur) / period).toFixed(3)};1`}
            keyPoints="0;0;1;1" calcMode="linear" />
        </circle>
      )}
    </g>
  ))}
  {boxes.map((b) => <rect class={`mf-n tone-${b.tone}${b.lit ? ' lit' : ''}`} x={b.x} y={b.y} width={b.w} height={b.h} rx="12" />)}
</svg>

<style>
  .mf { display: block; width: 100%; height: 100%; }
  .mf { --a: var(--lx-violet); --a2: var(--lx-glass); }
  .mf.b-pal { --a: var(--lx-pink); --a2: #ff9a5c; }
  .mf-fr { fill: none; stroke: var(--lx-ink-3); stroke-width: 2; stroke-dasharray: 8 8; opacity: 0.6; }
  .mf-fr.k-wall { stroke: var(--lx-glass); stroke-width: 4; stroke-dasharray: none; opacity: 0.9; }
  .mf-fr.k-deny { stroke: var(--lx-signal); }
  .mf-e path { fill: none; stroke: var(--lx-line); stroke-width: 3; }
  .mf-e.lit path { stroke: var(--a); stroke-width: 4; stroke-dasharray: 10 8; }
  .mf-e.deny path { stroke: var(--lx-signal); }
  .mf-dot { fill: var(--a2); filter: drop-shadow(0 0 6px var(--a2)); }
  .mf-e.deny .mf-dot { fill: var(--lx-signal); }
  .mf-n { fill: var(--lx-surface); stroke: var(--lx-line); stroke-width: 2.5; }
  .mf-n.tone-guest { fill: var(--lx-flame-soft); stroke: var(--lx-flame); }
  .mf-n.tone-host, .mf-n.tone-ok { fill: var(--lx-patina-soft); stroke: var(--lx-patina); }
  .mf-n.tone-store { fill: var(--lx-surface-2); }
  .mf-n.tone-client { stroke-dasharray: 8 6; }
  .mf-n.tone-deny { fill: var(--lx-signal-soft); stroke: var(--lx-signal); }
  .mf-n.tone-pal { fill: var(--lx-pink-soft); stroke: var(--lx-pink); }
  .mf-n.tone-rt { fill: var(--lx-violet-soft); stroke: var(--lx-violet); }
  .mf-n.lit { stroke: var(--a); stroke-width: 4; }
  @media (prefers-reduced-motion: no-preference) {
    .mf-e.lit path { animation: mf-march 1.1s linear infinite; }
  }
  @media (prefers-reduced-motion: reduce) { .mf-dot { display: none; } }
  @keyframes mf-march { to { stroke-dashoffset: -36; } }
</style>
