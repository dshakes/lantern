#!/bin/bash
# Sandbox recorder for cargo/go/npm: logs the call, fakes the artifacts that
# the next step looks for, never compiles anything.
set -uo pipefail
tool="$(basename "$0")"
n="$(command -v node || echo none)"
echo "$tool $* (cwd=${PWD#"$HOME"/}) node=${n#"$HOME"/}" >> "${STUB_STATE:?}/calls.log"
[[ -n "${STUB_BUILD_FAIL:-}" && "$tool $*" == *"$STUB_BUILD_FAIL"* ]] && { echo "stub $tool: injected build failure" >&2; exit 1; }
case "$tool $*" in
  "go build -o "*) mkdir -p "$(dirname "$4")"; echo "fake $PWD" > "$4"; chmod +x "$4" ;;
  "npm run build"*) mkdir -p .next/standalone; echo "// fake" > .next/standalone/server.js
    echo "  build-env NEXT_PUBLIC: $(env | sed -n 's/^\(NEXT_PUBLIC_[A-Z_]*\)=.*/\1/p' | sort | tr '\n' ' ')" >> "$STUB_STATE/calls.log" ;;
esac
exit 0
