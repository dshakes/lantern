<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>LISTEN_ADDR</key>
		<string>0.0.0.0:50054</string>
		<key>RUNTIME_BACKEND</key>
		<string>docker</string>
		<key>BUNDLE_S3_ENDPOINT</key>
		<string>http://localhost:9000</string>
		<key>BUNDLE_S3_BUCKET</key>
		<string>lantern-bundles</string>
		<key>NODE_ADVERTISE_ADDR</key>
		<string>localhost:50054</string>
		<key>NODE_REGION</key>
		<string>local</string>
		<key>NODE_ZONE</key>
		<string>local-a</string>
		<!-- Without SCHEDULER_URL the manager's self-register heartbeat
		     short-circuits at startup ("scheduler_url not set; skipping
		     self-register heartbeat"), so the node NEVER appears to the
		     scheduler. The scheduler's stale-node reaper then marks it
		     draining and every placement fails FailedPrecondition — a
		     cluster-wide outage with no error anywhere, because the manager
		     itself is healthy. This was observed live: a node draining for
		     days while the process ran fine. -->
		<key>SCHEDULER_URL</key>
		<string>http://localhost:8085</string>
		<!-- Pinned so the node keeps a stable identity across reboots;
		     unset falls back to the machine hostname, which changes on some
		     networks and silently registers a second node. -->
		<key>NODE_NAME</key>
		<string>local-dev</string>
		<key>LOG_LEVEL</key>
		<string>info</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:__HOME__/.cargo/bin:/opt/homebrew/opt/go/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>KeepAlive</key>
	<dict>
		<key>Crashed</key>
		<true/>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>Label</key>
	<string>dev.lantern.runtime-manager</string>
	<key>ProgramArguments</key>
	<array>
		<string>__REPO_ROOT__/scripts/launchd/run-microservice.sh</string>
		<string>runtime-manager</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/Lantern/runtime-manager.err.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/Lantern/runtime-manager.out.log</string>
	<key>ThrottleInterval</key>
	<integer>15</integer>
	<key>WorkingDirectory</key>
	<string>__REPO_ROOT__</string>
</dict>
</plist>
