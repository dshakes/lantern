# Shared look for the PAL README GIFs. Include with: Source docs/media/tapes/_settings.tape
Set Shell "bash"
Set FontFamily "Menlo"
Set FontSize 16
Set Width 1100
Set Height 600
Set Framerate 12
Set TypingSpeed 35ms
Set Padding 20
Set CursorBlink false
Set Theme { "name": "PAL Night", "black": "#0b1220", "red": "#ff7262", "green": "#4fc1a6", "yellow": "#ffb547", "blue": "#7cc4e8", "magenta": "#c9a7ff", "cyan": "#7cc4e8", "white": "#e8eef5", "brightBlack": "#5b6b82", "brightRed": "#ff8f82", "brightGreen": "#6fd3ba", "brightYellow": "#ffc670", "brightBlue": "#9ad3ee", "brightMagenta": "#d6bcff", "brightCyan": "#9ad3ee", "brightWhite": "#ffffff", "background": "#0b1220", "foreground": "#e8eef5", "selection": "#1c2a44", "cursor": "#ffb547" }
